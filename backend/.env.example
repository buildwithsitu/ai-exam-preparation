# ==============================================================================
# ExamMate AI - Backend Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-exammate-ai-2026

# Server Host & Port
HOST=0.0.0.0
PORT=5000

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/exammate_dev

# Test Database Configuration (Default in-memory for fast unit/integration testing)
TEST_DATABASE_URL=sqlite:///:memory:

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# SMTP Email Delivery (Gmail SMTP for Registration OTP Verification)
# ==============================================================================
# IMPORTANT: For Gmail, you must enable "2-Step Verification" in your Google
# Account settings, then generate a 16-character "App Password" at:
# https://myaccount.google.com/apppasswords
# Enter your credentials privately in your Render environment variables or local .env.
# NEVER commit real credentials to git!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Application Metadata
APP_NAME=ExamMate AI Backend
APP_VERSION=1.0.0
